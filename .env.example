# No PC: copie para ~/.brain/.env. Na VPS: defina como variáveis de ambiente no painel.

# --- Acesso (obrigatório na VPS) ---
# Senha do login do site. Sem ela o Brain se recusa a escutar fora de 127.0.0.1.
BRAIN_SENHA=
# Domínio(s) por onde o site é aberto, separados por vírgula.
BRAIN_HOSTS=brain.seudominio.com.br

# --- Agentes (VPS) ---
# Os agentes rodam pela ASSINATURA, não pela API. Não defina ANTHROPIC_API_KEY.
# O login do Claude, do Codex e do GitHub é feito pela página, em "Conexões".
# As duas variáveis abaixo são só uma alternativa a esse login:
# CLAUDE_CODE_OAUTH_TOKEN=   (gerado com `claude setup-token`)
# GH_TOKEN=                  (token do GitHub com escopo repo)

# Identidade dos commits feitos pelos agentes.
BRAIN_GIT_NOME=Phedro Borges
BRAIN_GIT_EMAIL=

# --- WhatsApp (Stevo) ---
STEVO_API_URL=
STEVO_API_KEY=
# Identificador do grupo de comandos (termina em @g.us). Só ele é ouvido.
BRAIN_WHATSAPP_GRUPO=
# Segredo do endereço do webhook: https://<domínio>/wa/<token>
BRAIN_WEBHOOK_TOKEN=

# --- Transcrição de áudio ---
# Único uso de API paga por uso. Esta chave não é repassada aos agentes.
OPENAI_API_KEY=

# --- Opcionais ---
# BRAIN_PORT=4848
# BRAIN_PROJETOS_DIR=~/projetos
# BRAIN_ROUTER_MODEL=haiku
